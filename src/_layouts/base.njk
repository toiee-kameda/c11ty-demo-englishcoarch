<!-- =====================================================
     ライブラリ読み込み & スクリプト
===================================================== -->
<!-- Lucide アイコン -->
<script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>

<!-- AOS スクロールアニメーション -->
<script src="https://unpkg.com/aos@2.3.4/dist/aos.js"></script>

<script>
  // ===== アイコン初期化 =====
  lucide.createIcons();

  // ===== AOS 初期化 =====
  AOS.init({ duration: 700, once: true, offset: 60 });

  // ===== ナビゲーション: スクロール時の背景切替 =====
  const nav = document.getElementById('main-nav');
  let ticking = false;

  function onScroll() {
    if (window.scrollY > 50) {
      nav.classList.add('nav-scrolled');
      nav.querySelectorAll('.nav-link').forEach(el => {
        el.classList.remove('text-white', 'text-white/80');
        el.classList.add('text-white');
      });
    } else {
      nav.classList.remove('nav-scrolled');
    }
    ticking = false;
  }

  window.addEventListener('scroll', () => {
    if (!ticking) {
      requestAnimationFrame(onScroll);
      ticking = true;
    }
  });

  // ===== モバイルメニュー開閉 =====
  const menuBtn = document.getElementById('menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  menuBtn.addEventListener('click', () => {
    const isOpen = mobileMenu.classList.toggle('hidden') === false;
    menuBtn.setAttribute('aria-expanded', String(isOpen));
    menuBtn.setAttribute('aria-label', isOpen ? 'メニューを閉じる' : 'メニューを開く');
    menuBtn.innerHTML = isOpen
      ? '<i data-lucide="x" class="w-6 h-6"></i>'
      : '<i data-lucide="menu" class="w-6 h-6"></i>';
    lucide.createIcons();
  });

  // モバイルメニューのリンクをクリックしたら閉じる
  mobileMenu.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu.classList.add('hidden');
      menuBtn.setAttribute('aria-expanded', 'false');
      menuBtn.setAttribute('aria-label', 'メニューを開く');
      menuBtn.innerHTML = '<i data-lucide="menu" class="w-6 h-6"></i>';
      lucide.createIcons();
    });
  });

  // ===== フォーム送信処理（デモ） =====
  function handleFormSubmit(e) {
    e.preventDefault();
    const form = e.target;
    const successMsg = document.getElementById('form-success');
    form.style.display = 'none';
    successMsg.classList.remove('hidden');
    lucide.createIcons();
  }

  // ===== FAQ: details/summary アコーディオン動作 =====
  document.querySelectorAll('.faq-item details').forEach(details => {
    details.addEventListener('toggle', () => {
      document.querySelectorAll('.faq-item details[open]').forEach(other => {
        if (other !== details) other.removeAttribute('open');
      });
    });
  });
</script>

</body>
</html>
