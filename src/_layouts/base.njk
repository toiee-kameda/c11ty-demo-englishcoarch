  <style type="text/tailwindcss">
    @theme {
      /* ===== カラーパレット ===== */
      --color-primary:   #1a3a52;
      --color-primary-dark: #0f2638;
      --color-primary-light: #2a5272;
      --color-accent:    #4a8fa8;
      --color-accent-light: #7ab5cc;
      --color-warm:      #c8a97e;
      --color-warm-light: #e8d5b7;
      --color-surface:   #f7f5f0;
      --color-surface-2: #edeae3;
      --color-text:      #1c1c2e;
      --color-text-muted: #6b7280;

      /* ===== フォント ===== */
      --font-sans: 'Noto Sans JP', sans-serif;
      --font-serif: 'Noto Serif JP', serif;
    }

    /* ===== ベーススタイル ===== */
    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: var(--font-sans);
      color: var(--color-text);
      background-color: var(--color-surface);
      line-height: 1.8;
    }

    /* ===== ナビゲーション ===== */
    .nav-scrolled {
      background-color: rgba(26, 58, 82, 0.92);
      backdrop-filter: blur(12px);
      box-shadow: 0 2px 20px rgba(0, 0, 0, 0.15);
    }

    /* ===== セクション見出し ===== */
    .section-label {
      font-size: 0.75rem;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--color-accent);
      font-weight: 500;
    }

    /* ===== ボーダーアクセント ===== */
    .border-accent-left {
      border-left: 3px solid var(--color-warm);
    }

    /* ===== カード ===== */
    .card-hover {
      transition: transform 0.25s ease, box-shadow 0.25s ease;
    }
    .card-hover:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 32px rgba(26, 58, 82, 0.12);
    }

    /* ===== グラデーション背景 ===== */
    .bg-primary-grad {
      background: linear-gradient(135deg, var(--color-primary-dark) 0%, var(--color-primary) 100%);
    }
    .bg-accent-grad {
      background: linear-gradient(135deg, var(--color-accent) 0%, var(--color-primary-light) 100%);
    }
  </style>
</head>

<body>

