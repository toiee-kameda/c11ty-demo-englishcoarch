---
layout: base.njk
---

<style>
  /* ===== ブログ記事プロース ===== */
  .prose {
    font-size: 1.0625rem;
    line-height: 1.85;
    color: var(--color-text);
  }
  .prose h2 {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-primary);
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
    padding-bottom: 0.4rem;
    border-bottom: 2px solid var(--color-warm-light);
  }
  .prose h3 {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--color-primary-light);
    margin-top: 2rem;
    margin-bottom: 0.5rem;
  }
  .prose h4 {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text);
    margin-top: 1.5rem;
    margin-bottom: 0.4rem;
  }
  .prose p {
    margin-bottom: 1.4rem;
  }
  .prose a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.2s;
  }
  .prose a:hover {
    color: var(--color-primary-light);
  }
  .prose strong {
    font-weight: 700;
    color: var(--color-primary);
  }
  .prose em {
    font-style: italic;
  }
  .prose ul, .prose ol {
    padding-left: 1.5rem;
    margin-bottom: 1.4rem;
  }
  .prose ul {
    list-style-type: disc;
  }
  .prose ol {
    list-style-type: decimal;
  }
  .prose li {
    margin-bottom: 0.4rem;
  }
  .prose li > ul, .prose li > ol {
    margin-top: 0.4rem;
    margin-bottom: 0;
  }
  .prose blockquote {
    border-left: 4px solid var(--color-warm);
    background-color: var(--color-surface-2);
    margin: 1.5rem 0;
    padding: 1rem 1.25rem;
    border-radius: 0 6px 6px 0;
    font-style: italic;
    color: var(--color-text-muted);
  }
  .prose blockquote p {
    margin-bottom: 0;
  }
  .prose code {
    background-color: var(--color-surface-2);
    color: var(--color-primary-light);
    font-size: 0.875em;
    padding: 0.15em 0.4em;
    border-radius: 4px;
    font-family: ui-monospace, 'Cascadia Code', 'Fira Code', monospace;
  }
  .prose pre {
    background-color: var(--color-primary-dark);
    color: #e2e8f0;
    padding: 1.25rem 1.5rem;
    border-radius: 8px;
    overflow-x: auto;
    margin: 1.5rem 0;
    font-size: 0.875rem;
    line-height: 1.7;
  }
  .prose pre code {
    background: none;
    color: inherit;
    padding: 0;
    font-size: inherit;
  }
  .prose table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.9375rem;
  }
  .prose thead th {
    background-color: var(--color-primary);
    color: white;
    padding: 0.6rem 1rem;
    text-align: left;
    font-weight: 600;
  }
  .prose tbody tr:nth-child(even) {
    background-color: var(--color-surface-2);
  }
  .prose tbody td {
    padding: 0.6rem 1rem;
    border-bottom: 1px solid var(--color-surface-2);
  }
  .prose hr {
    border: none;
    border-top: 2px solid var(--color-surface-2);
    margin: 2.5rem 0;
  }
  .prose img {
    max-width: 100%;
    border-radius: 8px;
    margin: 1.5rem auto;
    display: block;
  }
</style>

<!-- =====================================================
     ヒーローセクション
===================================================== -->
<section class="relative flex items-end -mt-16 lg:-mt-20" style="min-height: 340px; max-height: 460px; height: 38vw;">
  <!-- 背景画像 -->
  <div class="absolute inset-0 bg-cover bg-center"
       style="background-image: url('{{ heroImage or "https://images.unsplash.com/photo-1521321205814-9d673c65c167?w=1920&q=80&fm=webp&fit=crop" }}');">
    <!-- グラデーションオーバーレイ -->
    <div class="absolute inset-0"
         style="background: linear-gradient(to bottom, rgba(15,38,56,0.55) 0%, rgba(15,38,56,0.88) 100%);"></div>
  </div>

  <!-- コンテンツ -->
  <div class="relative w-full max-w-3xl mx-auto px-6 pb-10 pt-24">

    <!-- タグ -->
    {% set displayTags = [] %}
    {% for tag in tags %}
      {% if tag != 'post' %}
        {% set displayTags = (displayTags.push(tag), displayTags) %}
      {% endif %}
    {% endfor %}
    {% if displayTags.length %}
    <div class="mb-3 flex flex-wrap gap-2">
      {% for tag in displayTags %}
      <span class="text-xs font-medium px-3 py-1 rounded-full"
            style="background: rgba(74,143,168,0.25); color: #7ab5cc; border: 1px solid rgba(74,143,168,0.4);">
        {{ tag }}
      </span>
      {% endfor %}
    </div>
    {% endif %}

    <!-- タイトル -->
    <h1 class="text-2xl md:text-3xl lg:text-4xl font-bold text-white leading-snug mb-4"
        style="font-family: var(--font-serif); text-shadow: 0 2px 8px rgba(0,0,0,0.3);">
      {{ title }}
    </h1>

    <!-- メタ情報 -->
    <div class="flex flex-wrap items-center gap-4 text-white/60 text-sm">
      {% if page.date %}
      <time datetime="{{ page.date.toISOString() }}" class="flex items-center gap-1.5">
        <i data-lucide="calendar" class="w-3.5 h-3.5"></i>
        {{ page.date.toISOString().slice(0, 10) }}
      </time>
      {% endif %}
      {% if author %}
      <span class="flex items-center gap-1.5">
        <i data-lucide="user" class="w-3.5 h-3.5"></i>
        {{ author }}
      </span>
      {% endif %}
    </div>

  </div>
</section>


<!-- =====================================================
     記事本文
===================================================== -->
<article class="max-w-3xl mx-auto px-6 py-12">
  <div class="prose">
    {{ content | safe }}
  </div>

  <!-- 記事フッター -->
  <footer class="mt-12 pt-8 flex items-center justify-between"
          style="border-top: 1px solid var(--color-surface-2);">
    <a href="/blog/"
       class="inline-flex items-center gap-2 text-sm font-medium transition-colors"
       style="color: var(--color-accent);">
      <i data-lucide="arrow-left" class="w-4 h-4"></i>
      ブログ一覧へ戻る
    </a>
    {% if page.date %}
    <span class="text-xs" style="color: var(--color-text-muted);">
      公開日: {{ page.date.toISOString().slice(0, 10) }}
    </span>
    {% endif %}
  </footer>
</article>
