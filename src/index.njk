            type="text" id="name" name="name" required
            placeholder="山田 太郎"
            class="w-full px-4 py-3 rounded-xl bg-white/10 border border-white/20 text-white placeholder-white/40 focus:outline-none focus:border-accent-light focus:bg-white/15 transition-all text-sm"
