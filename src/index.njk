        >
          <option value="" class="text-gray-800">選択してください</option>
          <option value="beginner" class="text-gray-800">初心者（ほぼゼロから）</option>
          <option value="elementary" class="text-gray-800">初級（中学英語レベル）</option>
          <option value="intermediate" class="text-gray-800">中級（日常会話ができる）</option>
          <option value="advanced" class="text-gray-800">上級（ビジネス英語を目指したい）</option>
        </select>
      </div>

      <!-- 目標 -->
      <div>
        <label for="goal" class="block text-sm font-medium text-white/80 mb-2">
          英語学習の目標・ご相談内容 <span class="text-red-400">*</span>
        </label>
        <textarea
          id="goal" name="goal" required rows="4"
          placeholder="例：洋書をスラスラ読めるようになりたい、海外出張で英語を使えるようになりたい、TOEICスコアを上げたい、など"
          class="w-full px-4 py-3 rounded-xl bg-white/10 border border-white/20 text-white placeholder-white/40 focus:outline-none focus:border-accent-light focus:bg-white/15 transition-all text-sm resize-none"
        ></textarea>
      </div>

      <!-- 送信ボタン -->
      <button
        type="submit"
        class="w-full font-bold py-4 rounded-full text-base transition-all hover:opacity-90 hover:scale-[1.02] flex items-center justify-center gap-2"
        style="background-color: var(--color-warm); color: var(--color-primary-dark);">
        <i data-lucide="send" class="w-5 h-5"></i>
        無料相談を申し込む（30分・完全無料）
      </button>

      <p class="text-center text-white/50 text-xs">
        ※ 個人情報は厳重に管理し、相談目的以外には使用しません。
      </p>

    </form>

    <!-- 送信完了メッセージ（非表示） -->
    <div id="form-success" class="hidden mt-6 rounded-xl p-6 text-center"
         style="background-color: rgba(74, 143, 168, 0.2); border: 1px solid rgba(74, 143, 168, 0.4);">
      <i data-lucide="check-circle" class="w-10 h-10 mx-auto mb-3" style="color: var(--color-accent-light);"></i>
      <p class="font-bold text-lg mb-1">ありがとうございます！</p>
      <p class="text-white/70 text-sm">
        送信が完了しました。2営業日以内にご連絡いたします。
      </p>
    </div>

  </div>
</section>
